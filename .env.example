# Copie para .env e preencha com valores REAIS antes de subir o compose.
# Nenhum valor real de segredo pertence a este arquivo nem a nenhum arquivo versionado —
# norma "segredo", sobrescreve: nunca. Os valores abaixo são só formato de exemplo.

# --- Postgres ---
POSTGRES_DB=vermolinux
POSTGRES_USER=vermolinux
POSTGRES_PASSWORD=troque-este-valor

# --- Backend (Spring Boot) ---
# JWT_SECRET sobrescreve jwt.secret, hoje hardcoded em
# backend/src/main/resources/application.properties — gere um valor novo, aleatório,
# só para este ambiente (ex.: openssl rand -base64 48). NUNCA reaproveite o que está
# commitado no application.properties.
JWT_SECRET=troque-este-valor
# origem(ns) permitida(s) para CORS — a URL pública do frontend em produção
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Portas publicadas no host (Coolify pode remapear via proxy) ---
BACKEND_PORT=8080
FRONTEND_PORT=8081
